<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- SharpDTLS's own copy is visible through InternalsVisibleTo -->
    <MeziantouPolyfill_ExcludedPolyfills>P:System.Threading.Tasks.Task.IsCompletedSuccessfully</MeziantouPolyfill_ExcludedPolyfills>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
    <PackageReference Include="Meziantou.Polyfill" Version="1.0.170" Condition="'$(TargetFramework)' == 'net481'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpDTLS\SharpDTLS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Interop\wolfdtls13.c" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
